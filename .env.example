# Development settings (exported by the Makefile). TUNETRAIL_ names since ISSUE-111;
# KOITO_ names still work with a deprecation warning.
TUNETRAIL_LOG_LEVEL=debug
TUNETRAIL_CONFIG_DIR=.local/koito
TUNETRAIL_BIND_ADDR=127.0.0.1
TUNETRAIL_LISTEN_PORT=4110
# Development credentials, used only when creating a new database.
TUNETRAIL_DEFAULT_USERNAME=admin
TUNETRAIL_DEFAULT_PASSWORD=changeme
# Keep local development independent of external music services/imports.
TUNETRAIL_DISABLE_MUSICBRAINZ=true
TUNETRAIL_DISABLE_DEEZER=true
TUNETRAIL_DISABLE_COVER_ART_ARCHIVE=true
TUNETRAIL_SKIP_IMPORT=true
TZ=Etc/UTC
