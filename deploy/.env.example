KOITO_IMAGE_TAG=0.7
KOITO_HOST_BIND=127.0.0.1
KOITO_HOST_PORT=4110
# For an existing installation, use its absolute config/data directory.
KOITO_DATA_DIR=./data
KOITO_ADMIN_USERNAME=admin
# Required for a fresh installation. Existing accounts retain their passwords.
KOITO_ADMIN_PASSWORD=
KOITO_TIMEZONE=Etc/UTC
